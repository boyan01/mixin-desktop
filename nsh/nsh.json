{
  "name": "Mixin Messenger",
  "id": "one.mixin.messenger.nsh",
  "version": "7.0.0",
  "build": 2,
  "rust": ".",
  "root": "App",
  "theme": "theme.json",
  "appearance": "system",
  "icon": {
    "macos": "assets/app_icon.png"
  },
  "schemes": [
    "mixin"
  ],
  "window": {
    "defaultSize": {
      "width": 1280,
      "height": 750
    }
  },
  "macos": {
    "entitlements": {
      "com.apple.security.app-sandbox": true,
      "com.apple.security.device.audio-input": true,
      "com.apple.security.device.microphone": true,
      "com.apple.security.files.user-selected.read-write": true,
      "com.apple.security.network.client": true,
      "com.apple.security.network.server": true
    },
    "infoPlist": {
      "NSMicrophoneUsageDescription": "Record voice messages to send in your conversations.",
      "NSLocalNetworkUsageDescription": "Transfer your chat history between your own devices.",
      "NSSupportsAutomaticGraphicsSwitching": true
    }
  }
}
