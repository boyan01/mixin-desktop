{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for the Mixin desktop window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:webview:allow-create-webview-window",
    "core:window:allow-hide",
    "core:window:allow-start-dragging",
    "dialog:allow-open",
    "notification:default",
    "opener:default"
  ]
}
