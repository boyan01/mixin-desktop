{
  "name": "mixin-desktop-typescript",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "check": "npm run lint && npm run typecheck",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "debug:eval": "node scripts/debug-eval.mjs",
    "debug:hmr-revision": "node scripts/debug-hmr-revision.mjs",
    "debug:wait-hmr": "node scripts/debug-wait-hmr.mjs",
    "check:bindings": "npm run generate:bindings && git diff --exit-code -- src/generated/bindings.ts",
    "generate:bindings": "cargo test --manifest-path src-tauri/Cargo.toml export_typescript_bindings -- --nocapture",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -b --pretty false",
    "tauri": "node scripts/tauri.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-query": "^5.90.20",
    "@tanstack/react-virtual": "^3.14.9",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "lottie-web": "^5.13.0",
    "lucide-react": "^0.544.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1"
  }
}
